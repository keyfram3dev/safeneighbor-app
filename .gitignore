# Translation batch working files (intermediate artifacts)
/*.json
!/package.json
!/package-lock.json
!/firebase.json

# Translation review CSVs (generated by scripts/export-review-csvs.js)
scripts/review-csvs/

# External assets (reference files, not part of build)
/assets_external/
