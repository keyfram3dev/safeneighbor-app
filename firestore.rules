rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ICE Reports Collection - Community reporting with validation
    match /iceReports/{reportId} {

      // Anyone can read individual reports (needed for community awareness)
      // List queries are capped to prevent bulk scraping of the collection
      allow get: if true;
      allow list: if request.query.limit <= 100;

      // Create: Accept encrypted payload format OR legacy plaintext format
      allow create: if
        // New encrypted format: all sensitive fields in single encrypted payload
        (request.resource.data.encryptedPayload is string &&
         request.resource.data.encryptedPayload.size() >= 10 &&
         request.resource.data.payloadVersion is int &&
         request.resource.data.timestamp is string &&
         request.resource.data.verified is bool &&
         request.resource.data.verifiers is list)
        ||
        // Legacy plaintext format (backward compat for existing reports + encryption fallback)
        (request.resource.data.keys().hasAll(['timestamp', 'lat', 'lng', 'description']) &&
         request.resource.data.lat is number &&
         request.resource.data.lat >= 24 &&
         request.resource.data.lat <= 50 &&
         request.resource.data.lng is number &&
         request.resource.data.lng >= -125 &&
         request.resource.data.lng <= -66 &&
         request.resource.data.description is string &&
         request.resource.data.description.size() >= 1 &&
         request.resource.data.description.size() <= 500 &&
         request.resource.data.timestamp is string &&
         (!('encryptedDescription' in request.resource.data) ||
           request.resource.data.encryptedDescription is string) &&
         (!('descriptionVersion' in request.resource.data) ||
           request.resource.data.descriptionVersion is int) &&
         (!('agents' in request.resource.data) ||
           (request.resource.data.agents is int &&
            request.resource.data.agents >= 0 &&
            request.resource.data.agents <= 50)) &&
         (!('vehicles' in request.resource.data) ||
           (request.resource.data.vehicles is int &&
            request.resource.data.vehicles >= 0 &&
            request.resource.data.vehicles <= 20)) &&
         (!('verified' in request.resource.data) ||
           request.resource.data.verified is bool) &&
         (!('verifiers' in request.resource.data) ||
           request.resource.data.verifiers is list));

      // Update: Only allow modifying verification and flagging fields
      // Cap verifiers and flaggers lists to prevent spam
      allow update: if
        // Only verifiers, verified, and flaggers fields can be modified
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['verifiers', 'verified', 'flaggers']) &&

        // Verified must be boolean
        request.resource.data.verified is bool &&

        // Verifiers must be list, can only grow by exactly 1, max 50
        request.resource.data.verifiers is list &&
        request.resource.data.verifiers.size() == resource.data.verifiers.size() + 1 &&
        request.resource.data.verifiers.size() <= 50 &&

        // Flaggers: if being updated, must be a list that grows by exactly 1, max 50
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['flaggers']) ||
          (
            request.resource.data.flaggers is list &&
            request.resource.data.flaggers.size() == resource.data.get('flaggers', []).size() + 1 &&
            request.resource.data.flaggers.size() <= 50
          )
        );

      // Delete: Not allowed from client - server-side cleanup deletes reports after 48 hours
      allow delete: if false;
    }

    // Live Location Sharing — shareId acts as an unguessable secret
    // Location data is encrypted end-to-end (AES-256-GCM); key shared via URL fragment
    match /liveLocations/{shareId} {
      // Only allow reading a specific document (requires knowing the shareId)
      // Deny list queries to prevent enumeration of all live locations
      allow get: if true;
      allow list: if false;

      // Create: encrypted or plaintext (legacy) format
      allow create: if
        request.resource.data.keys().hasAll(['updatedAt', 'createdAt', 'active']) &&
        request.resource.data.updatedAt is string &&
        request.resource.data.createdAt is string &&
        request.resource.data.active is bool &&
        (
          // Encrypted format
          (request.resource.data.encryptedData is string &&
           request.resource.data.encryptedData.size() >= 1 &&
           request.resource.data.encryptedData.size() <= 10000)
          ||
          // Plaintext format (legacy — backward compatible)
          (request.resource.data.lat is number &&
           request.resource.data.lng is number &&
           request.resource.data.userName is string &&
           request.resource.data.userName.size() <= 100)
        );

      // Update: encrypted or plaintext fields, plus status
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['encryptedData', 'lat', 'lng', 'accuracy', 'address', 'updatedAt', 'active']) &&
        request.resource.data.updatedAt is string &&
        request.resource.data.active is bool;

      // Never delete from client — TTL cleanup via Cloud Function
      allow delete: if false;
    }

    // Rate limits — server-only (managed by Cloud Functions)
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // Push notification subscriptions — server-only (managed by Cloud Functions)
    match /pushSubscriptions/{subId} {
      allow read, write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
