\f2\fs18 {\listtext	\uc0\u8226 	}
\f1\fs26 CTA and small app/neighbor cue (icon, block name) near the bottom, leaving margins so nothing gets cut in previews.\uc0\u8232 \
\pard\pardeftab560\pardirnatural\partightenfactor0
\ls12\ilvl0
\f2\fs18 \cf0 {\listtext	\uc0\u8226 	}
